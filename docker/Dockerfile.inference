# Inference Service — can be swapped for a GPU-enabled base image:
#   FROM nvcr.io/nvidia/pytorch:24.01-py3
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
        fastapi \
        "uvicorn[standard]" \
        numpy \
        pydantic

COPY inference_service/ inference_service/

ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["uvicorn", "inference_service.app:app", \
     "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
