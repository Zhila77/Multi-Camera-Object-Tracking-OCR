# ============================================================
# EAIGLE AI — Pipeline image with NVIDIA DeepStream backend
#
# Base image: nvcr.io/nvidia/deepstream:7.0-gc-triton-devel
#   - Ubuntu 22.04 + CUDA 12.x + cuDNN
#   - All DeepStream GStreamer plugins (nvurisrcbin, nvstreammux, …)
#   - GStreamer 1.20
#
# Usage:
#   docker build -f docker/Dockerfile.pipeline-deepstream -t eaigle-pipeline-ds .
#   docker run --gpus all -e NVIDIA_DRIVER_CAPABILITIES=all eaigle-pipeline-ds
# ============================================================
FROM nvcr.io/nvidia/deepstream:7.0-gc-triton-devel

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-dev \
        python3-gi \
        python3-gst-1.0 \
        gir1.2-gst-rtsp-server-1.0 \
        libgstrtspserver-1.0-0 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pyds (DeepStream Python bindings)
# pyds wheel is bundled with DeepStream; pip name may vary by version
RUN pip3 install --no-cache-dir \
        pyds \
        || pip3 install --no-cache-dir \
               /opt/nvidia/deepstream/deepstream/lib/pyds*.whl 2>/dev/null \
        || echo "pyds install: will use system-installed bindings"

# Python pipeline dependencies
RUN pip3 install --no-cache-dir \
        uvloop \
        opencv-python-headless \
        numpy \
        "redis[asyncio]" \
        httpx \
        pyyaml \
        pydantic \
        prometheus-client \
        msgpack

COPY src/ src/
COPY configs/ configs/
COPY scripts/ scripts/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
# DeepStream requires this for GStreamer plugin discovery
ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins/
ENV LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib/:$LD_LIBRARY_PATH

CMD ["python3", "-m", "eaigle.app", "--config", "configs/pipeline.yaml"]
